# ==========================================
# AIMD Platform — Git Ignore Configuration
# ==========================================

# ── Python & Bytecode ──────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Virtual Environments ──────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── Testing, Coverage & Type Checking ──────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# ── Environment & Secrets ──────────────────
.env
.env.local
.env.*.local
*.env
!*.env.example

# ── Database & SQLite ─────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
aimd.db
backend/aimd.db
backend/aimd.db-shm
backend/aimd.db-wal
# Timestamped copies taken before a destructive operation. They contain real
# evidence rows and uploaded media, so they must never be committed.
backend/aimd.db.bak-*
backend/_pre_wipe_backup_*/
backend/.last_wipe_backup

# ── Media Ingestion & Processed Storage ────
uploads/
backend/uploads/
processed/
backend/processed/
frames/
backend/frames/
keyframes/
backend/keyframes/
storage/
backend/storage/

# ── ML Model Weights (do not commit) ─────
*.pt
*.pth
*.onnx
*.bin
*.ckpt
backend/yolov8n.pt
backend/models/
models/
weights/

# ── Test Artifacts & Temporary Files ──────
*.log
scratch/
tmp/
temp/
test.jpg
test.png
test.mp4
test_sample.*
backend/test.jpg
backend/test.png
backend/test.mp4
reports/
backend/reports/

# ── Node & Frontend ───────────────────────
node_modules/
web/node_modules/
web/dist/
web/.vite/
*.tsbuildinfo

# Files queued for deletion (see _to_delete/MANIFEST.md)
_to_delete/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── IDEs & Operating System ────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Local AI-tool folders (kept on disk, not in the repo)
.claude/
.agents/
.taste-skill/
skills-lock.json
