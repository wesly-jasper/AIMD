# AIMD Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env with real secrets

# ─── Application ──────────────────────────────────────────────────────────
APP_NAME=AIMD
APP_VERSION=1.0.0
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change_me_in_production_use_strong_random_value

# ─── Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
PROCESSED_DIR=processed
REPORT_DIR=reports
LOGS_DIR=logs
MAX_FILE_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=600
MAX_AUDIO_DURATION_SECONDS=600
MAX_IMAGE_DIMENSION=8000
PROCESSING_TIMEOUT_SECONDS=600

# ─── Database ────────────────────────────────────────────────────────────
# SQLite (local dev / testing):
DATABASE_URL=sqlite:///./aimd.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/aimd

# ─── CORS ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ─── Device ──────────────────────────────────────────────────────────────
# auto | cpu | cuda
DEVICE=auto

# ─── TruFor & AI Models (optional) ───────────────────────────────────────
TRUFOR_ENABLED=false
TRUFOR_MODEL_PATH=
AI_IMAGE_MODEL_PATH=
DEEPFAKE_MODEL_PATH=
AUDIO_MODEL_PATH=

# ─── Frame extraction ────────────────────────────────────────────────────
ANALYSIS_FPS=1.0
MAX_KEYFRAMES=50

# ─── External Search Providers (optional) ─────────────────────────────────
GOOGLE_VISION_API_KEY=
TINEYE_API_KEY=
