# AIMD Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env with real secrets

# ─── Application ──────────────────────────────────────────────────────────
APP_NAME=AIMD
APP_VERSION=1.0.0
# development | production. Outside development a missing AIMD_JWT_SECRET is a
# startup failure rather than a warning -- see below.
APP_ENV=development
LOG_LEVEL=INFO

# ─── Authentication ──────────────────────────────────────────────────────────
# JWT signing key. There is no default in source: the previous placeholder was
# committed to this repository's history, so it is permanently public and the
# application now refuses it. Generate your own:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Minimum 32 characters. Leave blank in development and an ephemeral key is
# generated per process (every restart invalidates outstanding tokens, and
# separate workers will not accept each other's tokens).
AIMD_JWT_SECRET=

# The first account, created at startup. There are no accounts in source -- the
# old admin/admin123 and investigator/investigator123 pairs were published
# credentials, not a demo. With these blank the user store is empty and every
# login is refused, which is the correct default until you choose a password.
# Minimum 12 characters.
AIMD_BOOTSTRAP_ADMIN_USERNAME=
AIMD_BOOTSTRAP_ADMIN_PASSWORD=

# ─── Rate limits ─────────────────────────────────────────────────────────────
# `limits` notation; several windows separated by ";" ("10/minute;100/hour").
# Counted per client address per endpoint, in process memory (each worker counts
# separately). Behind a reverse proxy, run uvicorn with
#   --proxy-headers --forwarded-allow-ips=<proxy address>
# or every client shares the proxy's single budget. A malformed value refuses
# to start rather than silently removing the limit.
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_UPLOAD=30/minute
RATE_LIMIT_ANALYSIS=10/minute

# ─── Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
PROCESSED_DIR=processed
REPORT_DIR=reports
LOGS_DIR=logs
MAX_FILE_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=600
MAX_AUDIO_DURATION_SECONDS=600
MAX_IMAGE_DIMENSION=8000
PROCESSING_TIMEOUT_SECONDS=600

# ─── Database ────────────────────────────────────────────────────────────
# SQLite (local dev / testing):
DATABASE_URL=sqlite:///./aimd.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/aimd

# ─── CORS ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ─── Device ──────────────────────────────────────────────────────────────
# auto | cpu | cuda
DEVICE=auto

# ─── TruFor & AI Models (optional) ───────────────────────────────────────
# TruFor is research / non-profit only and not in this repository. Install it
# with `python scripts/fetch_models.py` (from backend/), then point this at the
# directory it reports, e.g. TRUFOR_MODEL_PATH=models/trufor
TRUFOR_ENABLED=false
TRUFOR_MODEL_PATH=
# Images larger than TILE_SIZE² pixels run in overlapping tiles (peak ~2.2 GB of
# GPU memory at 1024; ~1.4 GB at 768). Size minus overlap must be a multiple of 8.
TRUFOR_TILE_SIZE=1024
TRUFOR_TILE_OVERLAP=128
# UnivFD AI-generation detector (MIT). Install the CLIP ViT-L/14 backbone and the
# UnivFD head with `python scripts/fetch_univfd.py` (see its --help for an offline
# download), then UNIVFD_MODEL_PATH=models/univfd. Its result is reported beside
# the manipulation verdict, never blended into it. The threshold applies to an
# uncalibrated sigmoid score.
UNIVFD_ENABLED=false
UNIVFD_MODEL_PATH=
UNIVFD_THRESHOLD=0.5
AI_IMAGE_MODEL_PATH=
DEEPFAKE_MODEL_PATH=
AUDIO_MODEL_PATH=

# ─── Similarity search ───────────────────────────────────────────────────
# Store a CLIP embedding per image at ingestion (uses UNIVFD_MODEL_PATH's
# backbone). A match is VERIFIED only when pHash distance, embedding cosine and
# ORB geometric inliers all pass; anything weaker is SIMILAR_UNVERIFIED.
SIMILARITY_EMBEDDING_ENABLED=false
SIMILARITY_PHASH_MAX_DISTANCE=10
# A sanity floor: a half-size recompressed copy of a small image can embed as
# low as ~0.73, so the cosine cannot tell copies from lookalikes on its own.
SIMILARITY_COSINE_MIN=0.70
SIMILARITY_MIN_INLIERS=20
# A crop verifies when the content matches after aligning the candidate to it.
SIMILARITY_ALIGNED_PHASH_MAX_DISTANCE=4
SIMILARITY_ALIGNED_NCC_MIN=0.90
SIMILARITY_ALIGNED_MIN_COVERAGE=0.90

# ─── Reference corpus (source discovery) ─────────────────────────────────
# Built by `python scripts/build_reference_corpus.py`. Wikimedia requires a
# contact (email address or URL) in every client's User-Agent. Images are
# stored under REFERENCE_DIR (default backend/storage/reference).
WIKIMEDIA_CONTACT=
# Source connectors. Each reports UNAVAILABLE when off, never "not found".
# Wikimedia searches the local corpus (no network at analysis time); URL
# verification fetches a user-supplied URL through the SSRF guard; Wayback looks
# up verified sources in the Internet Archive's CDX index.
SOURCE_WIKIMEDIA_ENABLED=true
SOURCE_URL_VERIFICATION_ENABLED=true
SOURCE_WAYBACK_ENABLED=true

# ─── Frame extraction ────────────────────────────────────────────────────
ANALYSIS_FPS=1.0
MAX_KEYFRAMES=50

# ─── NVIDIA Nemotron via Nebius Token Factory ──────────────────────────────
# Investigation agent. Leave the key blank and the agent reports UNAVAILABLE;
# every other feature still runs. Confirm the model id in the Token Factory
# catalogue before changing it. The key is read by the backend only.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
# Bounds on one investigation: model calls, wall-clock seconds for the whole
# run, client retries per call, completion tokens per call, and how many URLs
# verify_source_match may fetch (through the SSRF guard).
AGENT_ENABLED=true
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_RETRIES=2
AGENT_MAX_TOKENS=2048
AGENT_MAX_URL_CHECKS=2
# Investigations each user may start per hour (POST .../investigate -> 429).
AGENT_HOURLY_LIMIT=10

# ─── External Search Providers (optional, paid; not used by the free demo) ──
GOOGLE_VISION_API_KEY=
TINEYE_API_KEY=
