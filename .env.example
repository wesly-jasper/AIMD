# AIMD Environment Configuration
# Copy this file to .env and fill in your values

# ─── Application ────────────────────────────────────────────────────────────
APP_NAME=AIMD
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ─── Storage ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
PROCESSED_DIR=processed
MAX_FILE_SIZE_MB=500

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (local dev / testing):
DATABASE_URL=sqlite:///./aimd.db

# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/aimd

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── TruFor (optional ML model) ──────────────────────────────────────────────
TRUFOR_ENABLED=false
TRUFOR_MODEL_PATH=

# ─── External Search Providers (optional) ────────────────────────────────────
# Leave blank to disable internet source search (returns UNAVAILABLE)
GOOGLE_VISION_API_KEY=
TINEYE_API_KEY=
