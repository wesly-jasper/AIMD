    "/api/v1/analysis/": {
      "post": {
        "tags": [
          "Analysis"
        ],
        "summary": "Run forensic analysis pipeline",
        "description": "Run the complete AIMD forensic analysis pipeline on an uploaded media file.\n\nStages: metadata -> frames -> detection -> fingerprinting -> similarity\n        -> source tracing -> provenance -> evidence -> report\n\nAll results are persisted to the database and associated with the returned\nanalysis_id.\n\nThe analysis runs synchronously. For large video files this may take\nseveral minutes.",
        "operationId": "run_analysis_api_v1_analysis__post",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "requestBody": {
          "required": true,
