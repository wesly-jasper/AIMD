  "components": {
    "schemas": {
      "AnalysisRequest": {
        "properties": {
          "media_id": {
            "type": "string",
            "title": "Media Id"
          }
        },
        "type": "object",
        "required": [
          "media_id"
        ],
        "title": "AnalysisRequest",
        "description": "Request to run the full analysis pipeline on an already-uploaded media file."
      },
      "AnalysisResponse": {
        "properties": {
          "analysis_id": {
            "type": "string",
            "title": "Analysis Id"
          },
          "media_id": {
            "type": "string",
            "title": "Media Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "assessment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assessment"
          },
          "evidence_strength": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Strength"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "analysis_id",
          "media_id",
          "status"
        ],
        "title": "AnalysisResponse",
        "description": "Response from a pipeline analysis request.\n\nThere is deliberately no blended numeric confidence. A single number produced\nby averaging unrelated detector scores implies the detectors are independent\nmeasurements of one quantity, which they are not: ELA severity, copy-move\nkeypoint matches, and a face-region score measure different things on\nincomparable scales, and several share the same underlying JPEG artefacts.\nAveraging them manufactures precision that the evidence does not support.\n\n``evidence_strength`` is an ordinal summary of how well the observations\nsupport the stated assessment. It is not a probability and must not be\nrendered as a percentage."
      },
      "Body_upload_media_api_v1_media_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "case_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Id"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_media_api_v1_media_upload_post"
      },
      "CaseCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "CaseCreate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 254,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "SignupRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 150,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 12,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "SignupRequest"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
